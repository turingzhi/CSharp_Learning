{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Playground",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build Playground",
            "program": "${workspaceFolder}/src/IssueTracker.Playground/bin/Debug/net10.0/IssueTracker.Playground.dll",
            "cwd": "${workspaceFolder}/src/IssueTracker.Playground",
            "env": {
                "DOTNET_ROOT": "/opt/homebrew/opt/dotnet/libexec"
            },
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
